rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isVerified() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verificationStatus == 'approved';
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // Donor phone number is only visible to matched request participants
      match /profile/{field} {
        allow read: if isOwner(userId) || isAdmin();
      }
    }

    // Requests collection
    match /requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        // requester can only create a request tied to their own uid
        request.resource.data.requesterId == request.auth.uid;
      allow update: if isOwner(resource.data.requesterId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Donations collection
    match /donations/{donationId} {
      allow read: if isOwner(resource.data.donorId) || isAdmin() || isVerified();
      allow create: if isAuthenticated() && isVerified() &&
        // donor can only log a donation under their own uid
        request.resource.data.donorId == request.auth.uid;
      allow update: if isVerified() || isAdmin();
      allow delete: if isAdmin();
    }

    // Blood Inventory
    match /bloodInventory/{bankId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(bankId) || isAdmin();
      match /stock/{bloodGroup} {
        allow read: if isAuthenticated();
        allow write: if isOwner(bankId) || isAdmin();
      }
    }

    // Chats
    match /chats/{chatId} {
      allow read: if isOwner(resource.data.participantIds[0]) ||
                     isOwner(resource.data.participantIds[1]);
      allow create: if isAuthenticated() && isVerified();
      allow update: if isAuthenticated();

      match /messages/{messageId} {
        allow read: if isOwner(get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds[0]) ||
                       isOwner(get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds[1]);
        allow create: if isAuthenticated() && isVerified();
      }
    }

    // Notifications
    match /notifications/{userId} {
      allow read, write: if isOwner(userId);
      match /items/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Reports
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && isVerified();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Camps (NGO events)
    match /camps/{campId} {
      allow read: if isAuthenticated();
      allow create: if hasRole('ngo') || isAdmin();
      allow update: if hasRole('ngo') || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
