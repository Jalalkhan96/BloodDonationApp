{
  "name": "lifelink-functions",
  "description": "LifeLink Cloud Functions",
  "version": "1.0.0",
  "engines": {
    "node": "18"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "firebase-functions-test": "^3.2.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.19.0",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0"
  },
  "scripts": {
    "build": "tsc",
    "build:prod": "esbuild src/index.ts --bundle --platform=node --target=node18 --outfile=lib/index.js --minify --external:firebase-admin --external:firebase-functions",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "npm run build:prod && firebase deploy --only functions",
    "test": "jest",
    "lint": "eslint src/**/*.ts"
  },
  "private": true
}